{
  "name": "lily-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Lily — an AI teammate that joins meetings and dispatches work to each employee's own local coding agent.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "api",
    "orchestrator",
    "daemon",
    "emails",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "stage:check": "node scripts/check-stage.mjs",
    "smoke": "node scripts/smoke-local.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:verify": "npm run build && node scripts/db-verify.mjs",
    "dev:local": "npm run build && node scripts/dev-local.mjs",
    "totp": "node scripts/totp.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
