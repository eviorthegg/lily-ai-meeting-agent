# ---------------------------------------------------------------------------
# Web frontend environment.
#
# Copy to `.env.local` for a developer machine, or set these as environment
# variables per branch in the Amplify console for staging and production.
# Nothing in this file is committed with a real value — the root .gitignore
# ignores `.env.*` and allows only this example through.
#
# IMPORTANT: Vite inlines every VITE_* variable into the JavaScript bundle at
# build time. Everything below is readable by anyone who loads the page. Only
# publishable identifiers belong here. A secret placed in this file is a
# published secret.
# ---------------------------------------------------------------------------

# local | dev | prod. Defaults to local when unset. An unrecognised value is a
# hard failure rather than a fallback.
VITE_LILY_STAGE=local

# Defaults per stage to match LILY_API_BASE_URL in packages/shared, so a local
# developer usually needs no value here at all.
# VITE_LILY_API_BASE_URL=http://localhost:3000

# WebSocket API, for live presence in the dashboard. Matches LILY_WS_BASE_URL;
# the local default is the port api/src/local/ws-shim.ts listens on. The
# dashboard degrades to last-known-with-timestamp when this is unreachable.
# VITE_LILY_WS_BASE_URL=ws://localhost:3001

# mock | http. The REST API does not exist yet, so this defaults to `mock`
# everywhere except prod. Set to `http` to point the UI at a real API.
VITE_LILY_API_MODE=mock

# --- Analytics -------------------------------------------------------------
# Both are publishable identifiers by design, not secrets.
#
# GA4 is hard-disabled outside prod in code, mirroring the server-side rule, so
# setting this in local or dev has no effect. The tag is not injected into the
# document at all until a visitor accepts the analytics category.
# VITE_LILY_GA4_MEASUREMENT_ID=

# PostHog project key. EU ingest; the host default is https://eu.i.posthog.com.
# VITE_LILY_POSTHOG_KEY=
# VITE_LILY_POSTHOG_HOST=https://eu.i.posthog.com

# --- OAuth -----------------------------------------------------------------
# The public client id only. The client secret lives in the API's secret store
# and must never appear in a VITE_ variable.
# VITE_LILY_GOOGLE_CLIENT_ID=
