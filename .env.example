# ---------------------------------------------------------------------------
# Local stage configuration.
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and is read ONLY
# when LILY_STAGE=local — there is no code path that loads a file-backed secret
# in dev or prod, where everything resolves through Secrets Manager.
#
# Key names are the logical secret name uppercased with non-alphanumerics
# replaced by underscores: lily/local/mongo-uri -> LILY_LOCAL_MONGO_URI
# ---------------------------------------------------------------------------

LILY_STAGE=local

# --- Datastore -------------------------------------------------------------
# Local mongod (docker compose up mongo) or an Atlas dev cluster.
LILY_LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/lily_local

# --- Signing keys ----------------------------------------------------------
# Generate throwaway local values:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# These are per-developer and must never be shared or reused in a deployed stage.
LILY_LOCAL_JWT_SIGNING_KEY=
LILY_LOCAL_TOKEN_PEPPER=
# Separate from the pepper on purpose: rotating the pepper is routine and only
# forces everyone to sign in again, whereas rotating this makes every stored TOTP
# secret undecryptable and forces the whole company to re-enrol.
LILY_LOCAL_MFA_ENCRYPTION_KEY=

# --- OpenAI ----------------------------------------------------------------
# Required only to run the orchestrator locally against a real Realtime session.
# The rest of the system works without it.
LILY_LOCAL_OPENAI_API_KEY=

# --- Optional overrides ----------------------------------------------------
# LILY_WEB_BASE_URL=http://localhost:5173
# LILY_API_BASE_URL=http://localhost:3000
# LILY_WS_BASE_URL=ws://localhost:3001
# LILY_LOCAL_WS_CONTROL_URL=http://127.0.0.1:3002
# LILY_LOCAL_MAIL_DIR=tmp/mail
# LILY_REALTIME_MODEL=gpt-realtime-2.1
# LILY_REALTIME_VOICE=coral

# --- Never set locally -----------------------------------------------------
# Lemon Squeezy, PostHog and GA4 stay unset in local. Billing runs against
# Lemon Squeezy test mode in `dev` only, and GA4 is hard-disabled outside prod
# so a developer machine cannot pollute production analytics.
